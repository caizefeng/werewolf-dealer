# Copy to deploy/deploy.env (git-ignored) and fill in your own values.

# SSH target of your Docker host
DEPLOY_HOST=user@your-server
# directory on the host that receives the sources (docker compose runs there)
DEPLOY_DIR=/opt/werewolf-dealer
# public domain; its DNS record must point at the host
DOMAIN=werewolf.example.com
# host port the container is published on (bound to 127.0.0.1 only)
HOST_PORT=3232
# Caddy site file to install; your main Caddyfile must import it
# (e.g. `import /etc/caddy/sites/*.caddy`). Leave empty to manage the proxy yourself.
CADDY_SITE=/etc/caddy/sites/werewolf.caddy
CADDYFILE=/etc/caddy/Caddyfile
