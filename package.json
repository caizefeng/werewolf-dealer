{
  "name": "werewolf-dealer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Werewolf Dealer — 线下狼人杀发牌与法官助手",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "gen:audio": "python3 scripts/gen_audio.py"
  },
  "dependencies": {
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.7",
    "preact": "^10.29.8",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
